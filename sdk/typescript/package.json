{
  "name": "@getomnico/connector",
  "version": "0.1.0",
  "description": "TypeScript SDK for building Omni connectors",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "tsc --noEmit",
    "clean": "rm -rf dist"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "dependencies": {
    "express": "^4.21.0",
    "pino": "^10.3.1",
    "zod": "^4.6.6"
  },
  "peerDependencies": {
    "@modelcontextprotocol/sdk": "^1.32.0"
  },
  "peerDependenciesMeta": {
    "@modelcontextprotocol/sdk": {
      "optional": true
    }
  },
  "devDependencies": {
    "@modelcontextprotocol/sdk": "^1.32.0",
    "@types/express": "^5.0.0",
    "@types/node": "^22.19.15",
    "@types/supertest": "^6.0.0",
    "msw": "^2.6.0",
    "pino-pretty": "^13.1.3",
    "supertest": "^7.0.0",
    "typescript": "^5.6.0",
    "vitest": "^4.1.12"
  },
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/getomnico/omni"
  },
  "overrides": {
    "esbuild": "^0.28.1",
    "vite": "^7.3.7",
    "form-data": "^4.0.6",
    "qs": "^6.16.1",
    "hono": "^4.13.11",
    "@hono/node-server": "^2.1.3",
    "body-parser@^1": "^1.20.9",
    "body-parser@^2": "^2.4.0",
    "fast-uri": "^3.1.9",
    "postcss": "^8.5.18",
    "proxy-addr": "^2.0.8",
    "source-map-js": "^1.2.2",
    "ip-address": "^10.7.4"
  }
}
